{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Activate the git-lfs filter once per machine.
set -euo pipefail
{{ template "brew-env.sh" . }}

if ! command -v git-lfs >/dev/null 2>&1; then
  echo "git-lfs is not on PATH; skip git lfs install" >&2
  exit 0
fi

git lfs install --skip-repo >/dev/null
echo "git-lfs: filter installed"
{{- end -}}
