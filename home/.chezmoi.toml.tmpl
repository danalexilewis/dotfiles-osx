{{- $profiles := fromJson `{
  "full": {
    "mobile": true,
    "ai": true,
    "everyday": true,
    "pi": false,
    "cursorExtensions": true,
    "localAi": false
  },
  "local-ai": {
    "mobile": true,
    "ai": true,
    "everyday": true,
    "pi": false,
    "cursorExtensions": true,
    "localAi": true
  }
}` -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (keys $profiles | sortAlpha) "full" -}}
{{- $d := index $profiles $profile -}}
{{- $mobile := promptBoolOnce . "features.mobile" "Mobile toolchain (Xcode, Android, Expo)" $d.mobile -}}
{{- $ai := promptBoolOnce . "features.ai" "AI tools (T3, Claude, Codex, Cursor agent CLI)" $d.ai -}}
{{- $everyday := promptBoolOnce . "features.everyday" "Everyday apps (Spark, Obsidian, Figma, ...)" $d.everyday -}}
{{- $pi := promptBoolOnce . "features.pi" "Pi agent config" $d.pi -}}
{{- $cursorExtensions := promptBoolOnce . "features.cursorExtensions" "Install Cursor extensions" $d.cursorExtensions -}}
{{- $localAi := promptBoolOnce . "features.localAi" "Local AI apps (Ollama, LM Studio, OpenWhispr)" $d.localAi -}}
{{- $gitName := promptStringOnce . "git.name" "Git user.name" "Daniel Lewis" -}}
{{- $gitEmail := promptStringOnce . "git.email" "Git user.email" "dan.lewis@enspiral.com" -}}
# Generated by chezmoi init from home/.chezmoi.toml.tmpl.
# Re-run `chezmoi init --prompt` to change answers, or edit this file.

sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
    profile = {{ $profile | quote }}

    [data.features]
        mobile = {{ $mobile }}
        ai = {{ $ai }}
        everyday = {{ $everyday }}
        pi = {{ $pi }}
        cursorExtensions = {{ $cursorExtensions }}
        localAi = {{ $localAi }}

    [data.git]
        name = {{ $gitName | quote }}
        email = {{ $gitEmail | quote }}
