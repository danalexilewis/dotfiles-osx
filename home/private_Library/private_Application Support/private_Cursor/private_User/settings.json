	"mdx-preview.tailwind.enabled": "enabled",
	"mdx-preview.components.unknownBehavior": "raw",
	"mdx-preview.preview.codeBlockTheme": "atom-dark",
	"cursor.composer.customChimeSoundPath": "/Users/dan/Downloads/scifi_sound.mp3",
