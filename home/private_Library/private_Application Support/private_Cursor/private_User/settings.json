{
	"[dart]": {
		"editor.formatOnSave": true,
		"editor.formatOnType": true,
		"editor.rulers": [
			80
		],
		"editor.selectionHighlight": false,
		"editor.suggest.snippetsPreventQuickSuggestions": false,
		"editor.suggestSelection": "first",
		"editor.tabCompletion": "onlySnippets",
		"editor.wordBasedSuggestions": "off"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features",
		"editor.quickSuggestions": {
			"strings": true
		},
		"editor.suggest.insertMode": "replace",
		"gitlens.codeLens.scopes": [
			"document"
		]
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"codesnippetsai.defaultModel": "Google PaLM2",
	"codestream.email": "dan.lewis@bamboocreative.nz",
	"compile-hero.disable-compile-files-on-did-save-code": true,
	"editor.accessibilitySupport": "off",
	"editor.bracketPairColorization.enabled": true,
	"editor.defaultFormatter": "dbaeumer.vscode-eslint",
	"editor.inlineSuggest.enabled": true,
	"editor.linkedEditing": true,
	"editor.renderWhitespace": "all",
	"editor.stickyScroll.enabled": true,
	"editor.stickyTabStops": true,
	"editor.suggest.showStatusBar": true,
	"editor.tabSize": 2,
	"editor.wordWrap": "on",
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"explorer.incrementalNaming": "smart",
	"files.autoSave": "onFocusChange",
	"git.confirmSync": false,
	"git.enableCommitSigning": true,
	"git.enableSmartCommit": true,
	"git.ignoreRebaseWarning": true,
	"git.openRepositoryInParentFolders": "always",
	"javascript.updateImportsOnFileMove.enabled": "always",
	"liquid.format": true,
	"prettier.jsxSingleQuote": true,
	"prettier.singleQuote": true,
	"prettier.trailingComma": "none",
	"prettier.useTabs": true,
	"redhat.telemetry.enabled": false,
	"security.workspace.trust.untrustedFiles": "open",
	"settingsSync.ignoredExtensions": [
		"ms-vscode.test-adapter-converter"
	],
	"tabnine.debounceMilliseconds": 250,
	"tabnine.experimentalAutoImports": true,
	"tabnine.receiveBetaChannelUpdates": true,
	"terminal.integrated.env.osx": {
		"FIG_NEW_SESSION": "1"
	},
	"timeline.pageOnScroll": true,
	"todo-tree.general.tags": [
		"BUG",
		"HACK",
		"FIXME",
		"TODO",
		"XXX",
		"[ ]",
		"[x]",
		"INFO"
	],
	"todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
	"todo-tree.tree.showScanModeButton": false,
	"totalTypeScript.hiddenTips": [
		"basic-types",
		"passing-generics-to-types",
		"typeof",
		"any-type",
		"union-type",
		"ts-object-type",
		"type-alias-declaration",
		"undefined-keyword",
		"record-utility-type",
		"interface-with-generics",
		"generic-slots-in-functions",
		"in-operator-narrowing",
		"interface-with-multiple-generics",
		"keyof",
		"returntype-utility-type",
		"type-alias-with-generics",
		"omit-utility-type",
		"pick-utility-type",
		"tuple-type",
		"bigint",
		"type-predicate"
	],
	"totalTypeScript.hideAllTips": false,
	"totalTypeScript.hideBasicTips": true,
	"typescript.format.semicolons": "remove",
	"typescript.inlayHints.enumMemberValues.enabled": true,
	"typescript.updateImportsOnFileMove.enabled": "never",
