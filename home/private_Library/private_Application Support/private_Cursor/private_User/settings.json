	"window.autoDetectColorScheme": true,
	"workbench.preferredDarkColorTheme": "Cursor Dark High Contrast",
	"workbench.preferredLightColorTheme": "Cursor Dark High Contrast",
	"workbench.startupEditor": "none",
	"workbench.welcomePage.walkthroughs.openOnInstall": false,
	"editor.inlineSuggest.showToolbar": "always",
	"git.autofetch": true,
	"window.zoomLevel": 2,
	"pieces.setCopilotLocation": true,
	"terminal.external.osxExec": "Warp.app",
	"pieces.autocomplete": true,
	"pieces.cloudCapabilities": "Blended",
	"pieces.os.updateNotifications": "Major",
	"gitlens.showWelcomeOnInstall": false,
	"gitlens.plusFeatures.enabled": false,
	"editor.snippetSuggestions": "bottom",
	"diffEditor.ignoreTrimWhitespace": false,
	"workbench.editorAssociations": {
		"*.mdx": "default",
		"*.md": "workbench.editor.markdownPlan"
	},
	"[typescript]": {
		"editor.defaultFormatter": "rvest.vs-code-prettier-eslint"
	},
	"[svelte]": {
		"editor.defaultFormatter": "svelte.svelte-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"cmake.showOptionsMovedNotification": false,
	"rust-analyzer.inlayHints.implicitDrops.enable": true,
	"prettify-ts.enableHover": true,
	"prettify-ts.viewNestedTypes": true,
	"svelte.enable-ts-plugin": true,
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"prisma.showPrismaDataPlatformNotification": false,
	"gitlens.advanced.messages": {
		"suppressLineUncommittedWarning": true,
		"suppressIntegrationDisconnectedTooManyFailedRequestsWarning": true,
		"suppressIntegrationRequestTimedOutWarning": true
	},
	"editor.formatOnSave": true,
	"vim.statusBarColorControl": true,
	"vim.cursorStylePerMode.replace": "block-outline",
	"vim.foldfix": true,
	"vim.highlightedyank.enable": true,
	"vim.scroll": 5,
	"workbench.colorCustomizations": {
		"statusBar.background": "#005f5f",
		"statusBar.noFolderBackground": "#005f5f",
		"statusBar.debuggingBackground": "#005f5f",
		"statusBar.foreground": "#ffffff",
		"statusBar.debuggingForeground": "#ffffff"
	},
	"github.copilot.editor.enableAutoCompletions": true,
	"github.copilot.enable": {
		"*": false,
		"plaintext": false,
		"markdown": false,
		"scminput": false
	},
	"typescript.autoClosingTags": false,
	"javascript.autoClosingTags": false,
	"cursor.composer.shouldChimeAfterChatFinishes": true,
	"cursor.composer.shouldAllowCustomModes": true,
	"cursor.terminal.usePreviewBox": true,
	"workbench.colorTheme": "Default High Contrast",
	"window.commandCenter": true,
	"workbench.experimental.share.enabled": true,
	"editor.gotoLocation.multipleTypeDefinitions": "gotoAndPeek",
	"editor.gotoLocation.multipleReferences": "gotoAndPeek",
	"editor.gotoLocation.multipleImplementations": "gotoAndPeek",
	"editor.gotoLocation.multipleDefinitions": "gotoAndPeek",
	"editor.gotoLocation.multipleDeclarations": "gotoAndPeek",
	"todo-tree.highlights.customHighlight": {
		"INFO": {
			"icon": "info"
		},
		"BUG": {
			"icon": "bug"
		},
		"HACK": {
			"icon": "tools"
		},
		"FIXME": {
			"icon": "flame"
		},
		"XXX": {
			"icon": "x"
		},
		"[ ]": {
			"icon": "issue-draft"
		},
		"[x]": {
			"icon": "issue-closed"
		}
	},
	"[dockercompose]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"editor.quickSuggestions": {
			"other": true,
			"comments": false,
			"strings": true
		},
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"[github-actions-workflow]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"editor.minimap.enabled": true,
	"workbench.preferredHighContrastLightColorTheme": "Solarized Light",
	"cursor.inlineDiff.enablePerformanceProtection": false,
	"application.shellEnvironmentResolutionTimeout": 15,
	"terminal.integrated.enableMultiLinePasteWarning": "never",
	"markdown.preview.typographer": true,
	"markdown.updateLinksOnFileMove.enabled": "always",
	"update.releaseTrack": "dev",
	"update.mode": "silentlyApplyOnQuit",
	"cursor.rpcFileLogger.enabled": true,
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"yaml.disableSchemaDetection": [
