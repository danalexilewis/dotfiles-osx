#!/usr/bin/env bash
# Symlink curated config from this repo into $HOME.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
LINKS_FILE="$ROOT/links.conf"
BACKUP_ROOT="${DOTFILES_BACKUP_ROOT:-$HOME/.dotfiles-backup}"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP_DIR="$BACKUP_ROOT/$TIMESTAMP"
DRY_RUN=0
INSTALL_EXTENSIONS=0

usage() {
  cat <<'EOF'
Usage: ./install [--dry-run] [--extensions]

  --dry-run      Print actions without changing anything
  --extensions   Also install Cursor extensions from cursor/extensions.txt
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --extensions) INSTALL_EXTENSIONS=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

expand_home() {
  # Escape ~ in ${var#…} so bash does not tilde-expand the pattern to $HOME.
  case "$1" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s\n' "$HOME/${1#\~/}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

run() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY: $*"
  else
    "$@"
  fi
}

backup_path() {
  local target="$1"
  local rel="${target#"$HOME"/}"
  if [[ "$rel" == "$target" ]]; then
    rel="_absolute${target}"
  fi
  printf '%s\n' "$BACKUP_DIR/$rel"
}

link_one() {
  local src_rel="$1"
  local dest_spec="$2"
  local src="$ROOT/$src_rel"
  local dest
  dest="$(expand_home "$dest_spec")"

  if [[ ! -e "$src" && ! -L "$src" ]]; then
    echo "skip: missing source $src_rel" >&2
    return 0
  fi

  if [[ -L "$dest" ]]; then
    local current
    current="$(readlink "$dest")"
    if [[ "$current" == "$src" ]]; then
      echo "ok: $dest"
      return 0
    fi
  fi

  if [[ -e "$dest" || -L "$dest" ]]; then
    local backup
    backup="$(backup_path "$dest")"
    echo "backup: $dest -> $backup"
    run mkdir -p "$(dirname "$backup")"
    run mv "$dest" "$backup"
  else
    run mkdir -p "$(dirname "$dest")"
  fi

  echo "link: $src_rel -> $dest"
  run ln -s "$src" "$dest"
}

ensure_gitconfig_local() {
  local gitconfig="$HOME/.gitconfig"
  if [[ -e "$gitconfig" || -L "$gitconfig" ]]; then
    return 0
  fi
  echo "create: $gitconfig (per-machine; git --global writes here)"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY: touch $gitconfig"
  else
    touch "$gitconfig"
  fi
}

configure_hooks() {
  echo "hooks: core.hooksPath=.githooks"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "DRY: git -C $ROOT config core.hooksPath .githooks"
  else
    git -C "$ROOT" config core.hooksPath .githooks
  fi
}

print_hints() {
  echo
  echo "Hints (not installed by this script — use ./bootstrap on a new Mac):"
  if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    echo "  - oh-my-zsh missing: https://ohmyz.sh"
  fi
  if ! command -v brew >/dev/null 2>&1; then
    echo "  - Homebrew missing: https://brew.sh"
  elif [[ -f "$ROOT/Brewfile" ]]; then
    echo "  - apps: brew bundle --file=$ROOT/Brewfile"
  fi
  if ! command -v vp >/dev/null 2>&1 && [[ ! -x "$HOME/.local/share/vite-plus/bin/vp" ]]; then
    echo "  - Vite+ (vp) missing: brew install vite-plus"
  fi
}

install_extensions() {
  local list="$ROOT/cursor/extensions.txt"
  if [[ ! -f "$list" ]]; then
    echo "extensions: no cursor/extensions.txt" >&2
    return 0
  fi
  if ! command -v cursor >/dev/null 2>&1; then
    echo "extensions: cursor CLI not found; skip" >&2
    return 0
  fi
  while IFS= read -r ext || [[ -n "$ext" ]]; do
    [[ -z "$ext" || "$ext" == \#* ]] && continue
    echo "extension: $ext"
    if [[ "$DRY_RUN" -eq 1 ]]; then
      echo "DRY: cursor --install-extension $ext"
    else
      cursor --install-extension "$ext" || true
    fi
  done <"$list"
}

main() {
  echo "dotfiles-osx install (root=$ROOT)"
  [[ "$DRY_RUN" -eq 1 ]] && echo "(dry run)"

  while IFS= read -r line || [[ -n "$line" ]]; do
    # trim
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" != *" -> "* ]]; then
      echo "bad links.conf line: $line" >&2
      exit 1
    fi
    src_rel="${line%% -> *}"
    dest_spec="${line#* -> }"
    src_rel="${src_rel%"${src_rel##*[![:space:]]}"}"
    dest_spec="${dest_spec#"${dest_spec%%[![:space:]]*}"}"
    link_one "$src_rel" "$dest_spec"
  done <"$LINKS_FILE"

  ensure_gitconfig_local
  configure_hooks

  if [[ "$INSTALL_EXTENSIONS" -eq 1 ]]; then
    install_extensions
  fi

  print_hints
  echo
  echo "Done. Run ./doctor to verify."
}

main
