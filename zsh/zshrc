# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git z)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  echo "dotfiles: oh-my-zsh not found at $ZSH" >&2
fi

# Homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

typeset -U path PATH
path=("$HOME/.local/bin" $path)

# PostgreSQL client (Homebrew keg-only)
if command -v brew >/dev/null 2>&1; then
  pg_prefix="$(brew --prefix postgresql@16 2>/dev/null || true)"
  if [[ -n "$pg_prefix" && -d "$pg_prefix/bin" ]]; then
    path=("$pg_prefix/bin" $path)
  fi
fi

# pnpm global store (when used outside Vite+ managed mode)
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) path=("$PNPM_HOME" $path) ;;
esac

# Vite+ shims last so they win over Homebrew node
if [[ -f "$HOME/.config/vite-plus/env" ]]; then
  . "$HOME/.config/vite-plus/env"
fi

# Per-machine overrides (secrets, host-specific PATH, etc.)
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
