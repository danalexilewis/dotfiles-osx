#!/usr/bin/env bash
# One-shot new-machine setup: Homebrew apps + symlink config.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
INSTALL_EXTENSIONS=1

usage() {
  cat <<'EOF'
Usage: ./bootstrap [--no-extensions]

Assumes:
  - macOS Apple Silicon or Intel
  - network access
  - you can approve Homebrew / app install prompts

Steps:
  1. ./install-apps (Homebrew, App Store, Xcode, brew, CLIs, Expo)
  2. Install oh-my-zsh if missing
  3. ./install (symlinks)
  4. vp env default lts
  5. ./doctor
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-extensions) INSTALL_EXTENSIONS=0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

ensure_oh_my_zsh() {
  if [[ -d "$HOME/.oh-my-zsh" ]]; then
    echo "oh-my-zsh: already installed"
    return 0
  fi
  echo "Installing oh-my-zsh..."
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
}

main() {
  echo "dotfiles-osx bootstrap (root=$ROOT)"
  "$ROOT/install-apps"

  # git-lfs filter needs to be active once per machine
  if command -v git-lfs >/dev/null 2>&1; then
    git lfs install --skip-repo >/dev/null
  fi

  ensure_oh_my_zsh

  if [[ "$INSTALL_EXTENSIONS" -eq 1 ]]; then
    "$ROOT/install" --extensions
  else
    "$ROOT/install"
  fi

  if command -v vp >/dev/null 2>&1; then
    echo "vp env default lts"
    vp env default lts || true
  else
    echo "warn: vp not on PATH yet; open a new shell and run: vp env default lts" >&2
  fi

  "$ROOT/doctor"

  cat <<'EOF'

Bootstrap complete.

Still manual (one-time per machine):
  - ./install-apps asks for your password while setting up Xcode
  - Sign in to 1Password, then: gh auth login
  - eas login, when you first use EAS Build
  - Activate Lunar Pro in the Lunar app
  - Sign in to Cursor / Claude / Codex / T3 as needed
  - OAuth for Figma / Linear / PostHog MCP when first used
  - Put host-only secrets in ~/.zshrc.local
EOF
}

main
