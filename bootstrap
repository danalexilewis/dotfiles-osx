#!/usr/bin/env bash
# One-shot new-machine setup: Homebrew, chezmoi, then apply this repo.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PROMPT_BOOL=()

usage() {
  cat <<'EOF'
Usage: ./bootstrap [--no-extensions]

Assumes:
  - macOS Apple Silicon or Intel
  - network access
  - you can approve Homebrew / app install prompts

Steps:
  1. Install Homebrew if missing
  2. brew install chezmoi
  3. chezmoi init --apply --source <this repo>
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-extensions)
      PROMPT_BOOL+=(--promptBool "Install Cursor extensions=false")
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
  shift
done

ensure_homebrew() {
  if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
    return 0
  fi

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    return 0
  fi

  if [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
    return 0
  fi

  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    echo "Homebrew install finished but brew was not found." >&2
    exit 1
  fi
}

main() {
  echo "dotfiles-osx bootstrap (root=$ROOT)"

  ensure_homebrew

  echo "brew install chezmoi"
  brew install chezmoi

  echo "chezmoi init --apply --source $ROOT"
  if ((${#PROMPT_BOOL[@]})); then
    chezmoi init --apply --source "$ROOT" "${PROMPT_BOOL[@]}"
  else
    chezmoi init --apply --source "$ROOT"
  fi

  if [[ -x "$ROOT/doctor" ]]; then
    "$ROOT/doctor"
  fi

  cat <<'EOF'

Bootstrap complete.

Still manual (one-time per machine):
  - App Store / Xcode setup asks for your password
  - Sign in to 1Password, then: gh auth login
  - eas login, when you first use EAS Build
  - Activate Lunar Pro in the Lunar app
  - Sign in to Cursor / Claude / Codex / T3 as needed
  - OAuth for Figma / Linear / PostHog MCP when first used
  - Put host-only secrets in ~/.zshrc.local
EOF
}

main
